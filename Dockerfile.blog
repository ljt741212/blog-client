# Stage 1: Build blog (Next.js standalone)
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@10.6.3 --activate

WORKDIR /app

# Root workspace files for dependency resolution
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.json ./

# Copy package.json for workspace members so pnpm can resolve them
COPY apps/blog/package.json ./apps/blog/package.json
COPY packages/behaviorMonitor/package.json ./packages/behaviorMonitor/package.json
COPY packages/markdownEditor/package.json ./packages/markdownEditor/package.json

# Fetch and install all dependencies
RUN pnpm fetch --frozen-lockfile
RUN pnpm install --frozen-lockfile

# Copy source code
COPY apps/blog ./apps/blog
COPY packages ./packages

# Build only the blog app
RUN pnpm build:blog

# Stage 2: Production
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3005

COPY --from=builder /app/apps/blog/.next/standalone ./
COPY --from=builder /app/apps/blog/.next/static ./apps/blog/.next/static
COPY --from=builder /app/apps/blog/public ./apps/blog/public

EXPOSE 3005

CMD ["node", "apps/blog/server.js"]
